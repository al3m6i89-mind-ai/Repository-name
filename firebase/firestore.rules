rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function touchesModeration(keys) { return keys.hasAny(['banned', 'suspendedUntil', 'banReason']); }

    // Admin accounts are added by hand in the Firebase console.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /apps/{appId} {
      allow read, write: if isAdmin();

      match /users/{userId} {
        allow read, write: if isAdmin();
        // Each app user can see their own record and keep their name/email/lastSeen
        // up to date, but can never lift their own ban or suspension.
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
                      && !touchesModeration(request.resource.data.keys());
        allow update: if signedIn() && request.auth.uid == userId
                      && !touchesModeration(request.resource.data.diff(resource.data).affectedKeys());
      }
    }
  }
}
